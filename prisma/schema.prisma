// Booklet Studio — data model
// Run `npx prisma generate` after `npm install`, then `npx prisma migrate dev` against a real Postgres instance.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  DESIGNER
  COLLABORATOR
  VIEWER
}

enum Tier {
  FREE
  INDIE_ARTIST
  INDIE_LABEL
  ENTERPRISE
}

enum ReleaseStatus {
  DRAFT
  IN_REVIEW
  FINAL
  LIVE
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  passwordHash String?
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  comments     Comment[]
  passwordResetTokens PasswordResetToken[]
}

// Password reset tokens are stored hashed (never the raw token) — the same principle as
// passwordHash on User: if the database leaks, a stolen row shouldn't itself grant
// account takeover. The raw token only ever exists in the emailed link and briefly in
// request memory while hashing it for lookup.
model PasswordResetToken {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Org {
  id             String        @id @default(cuid())
  name           String
  slug           String?       @unique
  tier           Tier          @default(FREE)
  ssoEnabled     Boolean       @default(false)
  stripeCustomerId String?
  stripeSubscriptionId String?
  createdAt      DateTime      @default(now())
  memberships    Membership[]
  projects       Project[]
  assets         Asset[]
  themePresets   ThemePreset[]
  auditLogs      AuditLog[]
  ssoConfig      SsoConfig?
  parseJobs      DocumentParseJob[]
  exportJobs     ExportJob[]
}

model Membership {
  id      String @id @default(cuid())
  role    Role   @default(VIEWER)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String
  org     Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId   String

  @@unique([userId, orgId])
}

model Project {
  id          String        @id @default(cuid())
  name        String
  artist      String?
  formatId    String
  status      ReleaseStatus @default(DRAFT)
  releaseDate DateTime?
  metadata    Json
  theme       Json
  org         Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId       String
  pages       Page[]
  comments    Comment[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // "Standard web export" (product spec §11) — a hosted, shareable link at /p/[publicSlug],
  // available on every tier including Free (unlike the downloadable "Embeddable web
  // viewer" bundle, which is Indie Artist+ only — see ExportJob/type WEB_BUNDLE).
  // The slug is generated once on first publish and kept stable across re-publishes so a
  // link an artist has already shared never breaks.
  publicSlug    String?  @unique
  publicEnabled Boolean  @default(false)

  @@index([orgId])
}

model Page {
  id        String  @id @default(cuid())
  name      String
  order     Int
  blocks    Json
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  @@index([projectId])
}

model Asset {
  id        String   @id @default(cuid())
  key       String
  url       String
  type      String
  sizeBytes Int
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId     String
  createdAt DateTime @default(now())

  @@index([orgId])
}

model ThemePreset {
  id    String @id @default(cuid())
  name  String
  data  Json
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId String

  @@index([orgId])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  pageId    String?
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  createdAt DateTime @default(now())

  @@index([projectId])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  actorId   String
  targetId  String?
  meta      Json?
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId     String
  createdAt DateTime @default(now())

  @@index([orgId])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  projectId String
  pageId    String?
  type      String
  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([projectId, type, createdAt])
}

enum JobStatus {
  QUEUED
  PROCESSING
  DONE
  FAILED
}

enum ExportType {
  PDF
  WEB_BUNDLE
  IMAGES
}

enum SsoProviderKind {
  OIDC
}

// Queued job: extracts text from an uploaded lyric/liner-note document (DOCX/PDF/TXT)
// so the editor can pre-populate an editable text block. Runs off-request in the worker
// process (see worker/index.ts) so large files never block the API thread.
model DocumentParseJob {
  id           String    @id @default(cuid())
  org          Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId        String
  projectId    String
  requestedBy  String
  assetKey     String
  filename     String
  mimeType     String
  status       JobStatus @default(QUEUED)
  resultText   String?
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([orgId])
  @@index([projectId])
}

// Queued job: server-rendered export (high-res PDF, static web-viewer bundle, or image
// assets). Rendering a whole booklet can be slow, so it runs in the worker process and
// the client polls this row for status + the resulting asset URL.
model ExportJob {
  id           String     @id @default(cuid())
  org          Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId        String
  projectId    String
  requestedBy  String
  type         ExportType
  status       JobStatus  @default(QUEUED)
  resultUrl    String?
  errorMessage String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([orgId])
  @@index([projectId])
}

// Per-org SSO configuration (Enterprise tier). One row per org, OIDC authorization-code
// flow. clientSecret is stored encrypted at rest (see lib/crypto.ts) — never returned
// to the client in plaintext.
model SsoConfig {
  id                  String          @id @default(cuid())
  org                 Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId               String          @unique
  provider            SsoProviderKind @default(OIDC)
  issuer              String
  clientId            String
  clientSecretEncrypted String
  defaultRole         Role            @default(VIEWER)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}
