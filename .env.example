# Database — matches docker-compose.yml's Postgres credentials
DATABASE_URL="postgresql://booklet:booklet@localhost:5432/booklet_studio"

# NextAuth — REQUIRED. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-string"
NEXTAUTH_URL="http://localhost:3000"

# App
APP_URL="http://localhost:3000"

# Asset storage (S3-compatible) — required only for image/audio upload
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
ASSET_BUCKET="booklet-studio-assets"
ASSET_PUBLIC_BASE_URL="https://booklet-studio-assets.s3.amazonaws.com"

# Stripe — required only for self-serve tier upgrades (dev/set-tier route works without these)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_INDIE_ARTIST=""
STRIPE_PRICE_INDIE_LABEL=""

# Job queue — required for document parsing (lyric import) and server-rendered exports
# (PDF / web bundle / images). Matches docker-compose.yml's Redis service. Run the worker
# with `npm run worker` alongside `npm run dev` / `npm start`.
REDIS_URL="redis://localhost:6379"

# Web-viewer bundle exports embed this URL so fans viewing the exported .zip still send
# view/hotspot/play analytics back to your instance. Leave blank to disable tracking in
# exported bundles.
ANALYTICS_TRACK_URL="http://localhost:3000/api/analytics/track"

# SSO (Enterprise tier) — required only if any org enables SSO. Each org's issuer/client
# id/secret are stored per-org in the database (Team → SSO Settings); this key just
# encrypts those client secrets at rest. Generate with: openssl rand -base64 32
SSO_ENCRYPTION_KEY="replace-with-a-random-32-byte-string"

# Transactional email (password reset) — optional. Without it, reset emails are logged to
# the console instead of sent (fine for local dev, not for production). Uses Resend's
# plain REST API; see lib/email.ts if you'd rather use SES/Postmark/SendGrid.
RESEND_API_KEY=""
EMAIL_FROM="Booklet Studio <no-reply@example.com>"
