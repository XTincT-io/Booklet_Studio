# .env (secrets removed and replaced with placeholders)
# WARNING: This file previously contained committed secrets. Do NOT re-commit real credentials here.
# Replace placeholders with your rotated credentials and ensure .env is ignored by git (.gitignore already contains .env).

# Use the Neon pooler hostname you were given, but DO NOT commit user/password.
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<HOST>.neon.tech/<DB_NAME>?sslmode=require"
# If you need channel binding and your client/openssl/libpq supports it, append: &channel_binding=require
# Example (pooler host): postgresql://<user>:<pass>@ep-bitter-dream-azt9hlp6-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# NextAuth secret: generate a strong random value. Do not commit the real value.
NEXTAUTH_SECRET="<generate a new strong secret>"

# App URLs should point to your webserver (not the DB port 5432)
NEXTAUTH_URL="http://localhost:5432"
APP_URL="http://localhost:5432"

# ... other variables
